{
	"name": "@promptrails/n8n-nodes-promptrails",
	"version": "0.4.1",
	"description": "PromptRails nodes for n8n — execute agents, preview prompts, manage chat sessions, and more",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://promptrails.ai",
	"author": {
		"name": "PromptRails",
		"email": "support@promptrails.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/promptrails/n8n-nodes-promptrails.git"
	},
	"engines": {
		"node": ">=22.0"
	},
	"main": "index.js",
	"scripts": {
		"setup": "npm ci --ignore-scripts",
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"lint": "npm run check && npm run lint:n8n",
		"lint:n8n": "eslint --ext .ts nodes credentials && eslint package.json",
		"lintfix": "npm run check:fix && eslint --ext .ts nodes credentials --fix && eslint package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PromptRailsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PromptRails/PromptRails.node.js"
		]
	},
	"dependencies": {
		"@promptrails/sdk": "^0.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@typescript-eslint/parser": "~8.70.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"overrides": {
		"lodash": "^4.18.1",
		"form-data": "^4.0.6",
		"uuid": "^11.1.1"
	}
}
